---
const { current = "about" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const links = [
  { key: "about", label: "About", href: base },
  { key: "timeline", label: "Timeline", href: `${base}timeline/` },
  { key: "tags", label: "Tags", href: `${base}tags/` },
];
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Andy Wu home">
    <span class="site-brand__mark">AW</span>
    <span class="site-brand__name">Andy Wu</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {links.map((link) => (
      <a class:list={{ "is-current": current === link.key }} href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>
