---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

const about = await getEntry("pages", "about");
if (!about) throw new Error("About content not found");
const { Content } = await render(about);
---

<BaseLayout title="About / Andy Wu" description="Andy Wu's personal notes, writing, and background.">
  <div class="site-shell">
    <SiteHeader current="about" />
    <main class="page-layout">
      <article class="prose">
        <div class="page-kicker">About</div>
        <Content />
      </article>
      <aside class="page-aside">
        <p class="aside-label">A personal archive</p>
        <p>Writing, engineering notes, and the things worth keeping in view.</p>
        <a class="aside-link" href={`${import.meta.env.BASE_URL}timeline/`}>Browse the timeline <span>→</span></a>
      </aside>
    </main>
  </div>
</BaseLayout>
